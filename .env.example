# ─────────────────────────────────────────────────────────────────────────────
# Cricket Highlights — Environment Variables
# Copy this file to .env (root) and apps/web/.env, then fill in real values.
# NEVER commit .env or .env.local files.
# ─────────────────────────────────────────────────────────────────────────────

# ── InsForge project ──────────────────────────────────────────────────────────
# Get oss_host from .insforge/project.json after running: npx -y @insforge/cli link
INSFORGE_URL=https://your-appkey.region.insforge.app

# Get via: npx -y @insforge/cli secrets get ANON_KEY
INSFORGE_ANON_KEY=anon_...

# Get via: npx -y @insforge/cli secrets get API_KEY  (server-side only — never expose to frontend)
INSFORGE_API_KEY=...

# ── FastAPI backend ───────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=true

# Allowed CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:5173

# ── Gemini / LangGraph AI ─────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# ── Frontend (Vite) — must be prefixed with VITE_ ─────────────────────────────
# These two are safe to expose to the browser (anon key only, never API_KEY)
VITE_INSFORGE_URL=https://your-appkey.region.insforge.app
VITE_INSFORGE_ANON_KEY=anon_...

# FastAPI base URL (used by the frontend API client)
VITE_API_BASE_URL=http://localhost:8000
